<?xml version="1.0" encoding="UTF-8"?>
<!-- to build exes, run: mvn clean verify -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.alphagen.studio</groupId>
    <artifactId>FloatDataVisualizer</artifactId>
    <version>2.0.0</version> <!-- group 2 -->
    <packaging>jar</packaging>

    <name>FloatDataVisualizer</name>
    <!--    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--        <junit.version>5.12.1</junit.version>-->
        <argLine>
            --add-reads com.alphagnfss.etr3=org.junit.jupiter.api
            --add-opens com.alphagnfss.etr3/com.alphagnfss.etr3.database=org.junit.platform.commons
            --add-opens com.alphagnfss.etr3/com.alphagnfss.etr3.validation=org.junit.platform.commons
        </argLine>
    </properties>

    <profiles>
        <profile>
            <id>dmg</id>
            <activation>
                <property>
                    <name>dmg</name>
                </property>
            </activation>
            <properties>
                <installer.type>DMG</installer.type>
                <installer.icon>icon.icns</installer.icon>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <macPackageName>floatdatavisualizer</macPackageName>
                            <macSign>true</macSign>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>msi</id>
            <activation>
                <property>
                    <name>msi</name>
                </property>
            </activation>
            <properties>
                <installer.type>MSI</installer.type>
                <installer.icon>icon.ico</installer.icon>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <winShortcut>true</winShortcut>
                            <winMenu>true</winMenu>
                            <winPerUserInstall>true</winPerUserInstall>
                            <winDirChooser>true</winDirChooser>
                            <!--                            <winConsole>true</winConsole>-->
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>exe</id>
            <activation>
                <property>
                    <name>exe</name>
                </property>
            </activation>
            <properties>
                <installer.type>EXE</installer.type>
                <installer.icon>icon.ico</installer.icon>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <winShortcut>true</winShortcut>
                            <winMenu>true</winMenu>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>rpm</id>
            <activation>
                <property>
                    <name>rpm</name>
                </property>
            </activation>
            <properties>
                <installer.type>RPM</installer.type>
                <installer.icon>icon.png</installer.icon>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <linuxShortcut>true</linuxShortcut>
                            <linuxMenuGroup>Utility</linuxMenuGroup>
                            <linuxAppRelease>${version}</linuxAppRelease>
                            <linuxPackageName>floatdatavisualizer</linuxPackageName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>deb</id>
            <activation>
                <property>
                    <name>deb</name>
                </property>
            </activation>
            <properties>
                <installer.type>DEB</installer.type>
                <installer.icon>icon.png</installer.icon>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <linuxShortcut>true</linuxShortcut>
                            <linuxMenuGroup>Utility</linuxMenuGroup>
                            <linuxAppRelease>${version}</linuxAppRelease>
                            <linuxPackageName>floatdatavisualizer</linuxPackageName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>

            <!--     Nitrite BOM     -->

            <!-- Source: https://mvnrepository.com/artifact/org.dizitart/nitrite-bom -->
            <dependency>
                <groupId>org.dizitart</groupId>
                <artifactId>nitrite-bom</artifactId>
                <version>5.3.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--    JavaFX: GUI    -->

        <!-- Source: https://mvnrepository.com/artifact/org.openjfx/javafx-controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>25</version>
            <scope>compile</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.openjfx/javafx-fxml -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>25</version>
            <scope>compile</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.openjfx/javafx-graphics -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>25</version>
            <scope>compile</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.openjfx/javafx-swing -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>25</version>
            <scope>compile</scope>
        </dependency>

        <!--    Lombok: Annotation    -->

        <!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>compile</scope>
        </dependency>

        <!--    Apache Log4J: Logging    -->

        <!-- Source: https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-core -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.26.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-api -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.26.1</version>
            <scope>compile</scope>
        </dependency>

        <!--    SLF4J-Log4J: Logging Adapter    -->

        <!-- Source: https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-slf4j2-impl -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.26.1</version>
            <scope>compile</scope>
        </dependency>

        <!--    JUnit 5: Unit Testing    -->

        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-engine -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <!--    Nitrite: NoSQL Serverless Database    -->

        <!-- Source: https://mvnrepository.com/artifact/org.dizitart/nitrite -->
        <dependency>
            <groupId>org.dizitart</groupId>
            <artifactId>nitrite</artifactId>
            <version>5.3.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.dizitart/nitrite-mvstore-adapter -->
        <dependency>
            <groupId>org.dizitart</groupId>
            <artifactId>nitrite-mvstore-adapter</artifactId>
            <version>5.3.0</version>
            <scope>compile</scope>
        </dependency>

        <!--    Jackson: JSON Parser    -->

        <!-- Source: https://mvnrepository.com/artifact/tools.jackson.core/jackson-databind -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.4</version>
            <scope>compile</scope>
        </dependency>

        <!--    jSerialComm: Serial Comms    -->

        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.11.2</version>
        </dependency>

        <!--    jSystemThemeDetector: System Theme Detector    -->

        <!-- Source: https://mvnrepository.com/artifact/com.github.Dansoftowner/jSystemThemeDetector -->
        <dependency>
            <groupId>com.github.Dansoftowner</groupId>
            <artifactId>jSystemThemeDetector</artifactId>
            <version>3.9.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Source: https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-surefire-plugin -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>com.alphagen.studio.FloatDataVisualizer.Launcher</mainClass>
                            <options>
                                <option>--enable-native-access=javafx.graphics</option>
                            </options>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Jar Plugin: Outputs the main project JAR directly into target/libs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.5</version>
                <configuration>
                    <name>FloatDataVisualizer</name>
                    <appVersion>${version}</appVersion>

                    <vendor>Aadarsh Devi</vendor>
                    <description>Float Data Visualizer is a Data Acquisition App for the MateFloat Competition.
                    </description>

                    <destination>${project.build.directory}/dist</destination>
                    <module>com.alphagnfss.etr3/com.alphagnfss.etr3.Launcher</module>
                    <!--suppress UnresolvedMavenProperty -->
                    <type>${installer.type}</type>
                    <icon>${project.build.directory}/classes/${installer.icon}</icon>
                    <javaOptions>
                        <option>--enable-native-access=javafx.graphics</option>
                    </javaOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>